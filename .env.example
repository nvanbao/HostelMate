# Frontend: relative path, the Vite dev server proxies /api to the backend
VITE_API_URL=/api

# Server
PORT=5000
# Required when NODE_ENV=production. Generate one with: openssl rand -base64 48
JWT_SECRET=
# Required the first time the server starts with NODE_ENV=production. Defaults to 123456 in development.
ADMIN_INITIAL_PASSWORD=
# Optional, defaults to server/hostelmate.sqlite
DATABASE_PATH=

# Optional: Google login
GOOGLE_CLIENT_ID=
VITE_GOOGLE_CLIENT_ID=

# Optional: AI chatbot
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.1-flash-lite

# VietQR: example values, replace with the account that receives payments
BANK_ID=970422
BANK_ACCOUNT_NO=0123456789
BANK_ACCOUNT_NAME="TEN CHU TAI KHOAN"
VIETQR_TEMPLATE=compact2
PAYMENT_PREFIX=HM

# Optional: SePay webhook. It answers 503 until a key is set.
SEPAY_WEBHOOK_API_KEY=
SEPAY_ALLOWED_ACCOUNT_NUMBERS=

LANDLORD_NAME=Chủ trọ HostelMate
LANDLORD_PHONE=
RESET_DB_ON_START=false
