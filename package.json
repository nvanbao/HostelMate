{
  "name": "hostelmate",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "server": "node --watch server/server.js",
    "dev:all": "concurrently -k -n WEB,API -c blue,green \"npm run dev\" \"npm run server\"",
    "start": "npm run dev:all",
    "build": "vite build",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit -p tsconfig.app.json && tsc --noEmit -p tsconfig.node.json",
    "verify": "npm run typecheck && npm run test && npm run build",
    "reset-db": "node server/reset-db.js",
    "test:server": "npm --prefix server run test --",
    "test": "npm run test:web && npm run test:server",
    "test:web": "vitest run",
    "start:prod": "npm run build && node server/server.js",
    "test:e2e": "playwright test"
  },
  "dependencies": {
    "@react-oauth/google": "^0.13.5",
    "@tailwindcss/typography": "^0.5.20",
    "lucide-react": "^0.344.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-icons": "^5.7.0",
    "react-markdown": "^10.1.0",
    "react-signature-canvas": "^1.1.0-alpha.2",
    "remark-gfm": "^4.0.1",
    "socket.io-client": "^4.8.3"
  },
  "devDependencies": {
    "@eslint/js": "^9.9.1",
    "@playwright/test": "^1.49.1",
    "@types/node": "^22.20.5",
    "@types/react": "^18.3.5",
    "@types/react-dom": "^18.3.0",
    "@types/react-signature-canvas": "^1.0.7",
    "@vitejs/plugin-react": "^4.3.1",
    "autoprefixer": "^10.4.18",
    "concurrently": "^8.2.2",
    "eslint": "^9.9.1",
    "eslint-plugin-react-hooks": "^5.1.0-rc.0",
    "eslint-plugin-react-refresh": "^0.4.11",
    "globals": "^15.9.0",
    "postcss": "^8.4.35",
    "tailwindcss": "^3.4.1",
    "typescript": "^5.5.3",
    "typescript-eslint": "^8.3.0",
    "vite": "^5.4.2",
    "vitest": "^2.1.9"
  },
  "description": "Hệ thống quản lý phòng trọ: hợp đồng, điện nước, hóa đơn VietQR, sửa chữa và chatbot AI",
  "engines": {
    "node": ">=22.13"
  },
  "author": "Nguyen Van Bao"
}
